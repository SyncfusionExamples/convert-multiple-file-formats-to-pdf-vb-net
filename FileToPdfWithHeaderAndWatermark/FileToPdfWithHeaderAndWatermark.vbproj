<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FileToPdfWithHeaderAndWatermark</RootNamespace>
    <AssemblyName>FileToPdfWithHeaderAndWatermark</AssemblyName>
    <StartupObject>FileToPdfWithHeaderAndWatermark.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <ApplicationManifest></ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <SyncfusionVersion>35.1.41</SyncfusionVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Pdf.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.DocIO.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.DocToPdfConverter.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.XlsIO.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.ExcelToPdfConverter.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Presentation.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.PresentationToPdfConverter.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.WinForms" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Markdown" Version="$(SyncfusionVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample files in the project's input folder are copied next to the executable and loaded at startup. -->
    <None Include="input\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="input" />
  </ItemGroup>

</Project>
